---
import { asc } from 'drizzle-orm';
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { categories, publishers } from '../../db/schema';

export const prerender = true;

const db = getDatabase();
const selectedCategoryIds = Array.from(
    new Set(
        Astro.url.searchParams
            .getAll('category')
            .map((value) => Number(value))
            .filter((value) => Number.isInteger(value) && value > 0),
    ),
);
const selectedPublisherId = (() => {
    const value = Astro.url.searchParams.get('publisher');
    const parsedValue = value === null ? NaN : Number(value);
    return Number.isInteger(parsedValue) && parsedValue > 0 ? parsedValue : null;
})();
const allCategories = await db
    .select({ id: categories.id, name: categories.name })
    .from(categories)
    .orderBy(asc(categories.name));
const allPublishers = await db
    .select({ id: publishers.id, name: publishers.name })
    .from(publishers)
    .orderBy(asc(publishers.name));
const games = await getAllGames(db, {
    categoryIds: selectedCategoryIds.length > 0 ? selectedCategoryIds : undefined,
    publisherIds: selectedPublisherId !== null ? [selectedPublisherId] : undefined,
});
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-2xl border border-slate-700 bg-slate-900/60 p-5 shadow-lg">
      <form data-testid="game-filter-form" class="space-y-6" aria-label="Game filters">
        <fieldset>
          <legend class="mb-3 text-sm font-medium uppercase tracking-wide text-slate-300">Categories</legend>
          <div class="flex flex-wrap gap-3">
            {allCategories.map((category) => (
              <label
                class="flex cursor-pointer items-center gap-2 rounded-full border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500 focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/60"
              >
                <input
                  type="checkbox"
                  name="category"
                  value={category.id}
                  checked={selectedCategoryIds.includes(category.id)}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                  data-testid="category-filter"
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div class="w-full md:max-w-xs">
            <label for="publisher-filter" class="mb-2 block text-sm font-medium uppercase tracking-wide text-slate-300">
              Publisher
            </label>
            <select
              id="publisher-filter"
              name="publisher"
              value={selectedPublisherId ?? 'all'}
              data-testid="publisher-filter"
              aria-label="Filter games by publisher"
              class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-slate-200 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/60"
            >
              <option value="all">All publishers</option>
              {allPublishers.map((publisher) => (
                <option value={publisher.id}>{publisher.name}</option>
              ))}
            </select>
          </div>

          <button
            type="button"
            data-testid="clear-filters-button"
            class="rounded-lg border border-slate-600 bg-slate-800 px-4 py-2 text-sm font-medium text-slate-100 transition-colors hover:border-blue-500 hover:text-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            Clear filters
          </button>
        </div>
      </form>

      <p class="mt-4 text-sm text-slate-300" data-testid="game-results-count" aria-live="polite">
        {games.length === 1 ? '1 game shown' : `${games.length} games shown`}
      </p>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div
            class="hidden rounded-xl border border-slate-700 bg-slate-900/40 p-6 text-slate-300"
            data-testid="filter-empty-state"
            role="status"
            aria-live="polite"
          >
            No games match the current filters. Try clearing a filter to see more results.
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>

  <script>
    const categoryInputs = Array.from(document.querySelectorAll('[data-testid="category-filter"]')) as HTMLInputElement[];
    const publisherSelect = document.querySelector('[data-testid="publisher-filter"]') as HTMLSelectElement | null;
    const clearFiltersButton = document.querySelector('[data-testid="clear-filters-button"]') as HTMLButtonElement | null;
    const gameCards = Array.from(document.querySelectorAll('[data-testid="game-card"]')) as HTMLElement[];
    const gamesGrid = document.querySelector('[data-testid="games-grid"]') as HTMLElement | null;
    const emptyState = document.querySelector('[data-testid="filter-empty-state"]') as HTMLElement | null;
    const resultsCount = document.querySelector('[data-testid="game-results-count"]') as HTMLElement | null;

    const getSelectedCategories = () =>
      categoryInputs
        .filter((input) => (input instanceof HTMLInputElement ? input.checked : false))
        .map((input) => Number((input as HTMLInputElement).value));

    const getSelectedPublisher = () => {
      if (!publisherSelect || publisherSelect instanceof HTMLSelectElement === false) {
        return null;
      }

      const value = publisherSelect.value;
      return value === 'all' || value === '' ? null : Number(value);
    };

    const updateQueryString = () => {
      const params = new URLSearchParams(window.location.search);
      params.delete('category');
      params.delete('publisher');

      const selectedCategories = getSelectedCategories();
      selectedCategories.forEach((categoryId) => params.append('category', String(categoryId)));

      const selectedPublisher = getSelectedPublisher();
      if (selectedPublisher !== null) {
        params.set('publisher', String(selectedPublisher));
      }

      const nextUrl = `${window.location.pathname}${params.toString() ? `?${params.toString()}` : ''}`;
      window.history.replaceState({}, '', nextUrl);
    };

    const applyFilters = () => {
      const selectedCategories = getSelectedCategories();
      const selectedPublisher = getSelectedPublisher();
      let visibleCount = 0;

      for (const card of gameCards) {
        const categoryId = card.getAttribute('data-game-category-id');
        const publisherId = card.getAttribute('data-game-publisher-id');
        const categoryMatch =
          selectedCategories.length === 0 ||
          (categoryId !== null && categoryId !== '' && selectedCategories.includes(Number(categoryId)));
        const publisherMatch =
          selectedPublisher === null ||
          (publisherId !== null && publisherId !== '' && Number(publisherId) === selectedPublisher);

        const match = categoryMatch && publisherMatch;
        card.hidden = !match;
        if (match) {
          visibleCount += 1;
        }
      }

      const hasResults = visibleCount > 0;
      if (gamesGrid) {
        gamesGrid.hidden = !hasResults;
      }
      if (emptyState) {
        emptyState.hidden = hasResults;
      }
      if (resultsCount) {
        resultsCount.textContent = hasResults
          ? visibleCount === 1
            ? '1 game shown'
            : `${visibleCount} games shown`
          : 'No games match the current filters';
      }

      updateQueryString();
    };

    if (categoryInputs.length > 0 || publisherSelect) {
      categoryInputs.forEach((input) => {
        input.addEventListener('change', applyFilters);
      });
      publisherSelect?.addEventListener('change', applyFilters);
      clearFiltersButton?.addEventListener('click', () => {
        categoryInputs.forEach((input) => {
          if (input instanceof HTMLInputElement) {
            input.checked = false;
          }
        });
        if (publisherSelect instanceof HTMLSelectElement) {
          publisherSelect.value = 'all';
        }
        applyFilters();
      });
      applyFilters();
    }
  </script>
</Layout>
